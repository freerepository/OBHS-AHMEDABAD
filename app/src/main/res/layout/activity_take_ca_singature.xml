<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".activitylinen.TakeCaSingatureActivity">
    <RelativeLayout
        android:id="@+id/rl"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        android:background="@color/colorAccentlinen"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/v_back"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:visibility="gone"
            android:src="@drawable/back"
            app:tint="@color/colorWhite" />

        <TextView
            android:id="@+id/tv_toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="20dp"
            android:textAppearance="@android:style/TextAppearance.Medium"
            android:text="Take Images and Signatures"/>

    </RelativeLayout>
    <LinearLayout
        android:id="@+id/camera_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_white"
        android:layout_below="@id/rl"
        android:orientation="horizontal"
        android:layout_margin="@dimen/_8sdp"
        android:padding="8dp">
        <LinearLayout
            android:id="@+id/ll1"
            android:orientation="vertical"
            android:layout_width="@dimen/_140sdp"
            android:layout_height="@dimen/_140sdp"
            android:layout_weight="1"
            android:background="@drawable/bg_white"
            android:elevation="2dp"
            android:layout_margin="8dp">
            <ImageView
                android:id="@+id/iv_train1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_camera"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll2"
            android:orientation="vertical"
            android:layout_width="@dimen/_140sdp"
            android:layout_height="@dimen/_140sdp"
            android:layout_weight="1"
            android:background="@drawable/bg_white"
            android:elevation="2dp"
            android:layout_margin="8dp">
            <ImageView
                android:id="@+id/iv_train2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_camera"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/signature_layout"
        android:layout_below="@id/camera_layout"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_margin="@dimen/_8sdp"
        android:background="@drawable/bg_white"
        android:orientation="horizontal">

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_outline"
            android:layout_margin="8dp"
            android:elevation="2dp">
            <TextView
                android:id="@+id/tv1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="Signature of supervisor"/>
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="4dp"
                android:layout_below="@id/tv1"
                android:layout_alignParentEnd="true"
                android:id="@+id/click1"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/icon_pen"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="80dp"
                android:layout_below="@id/tv1"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/click1"
                android:layout_marginEnd="38sp"
                android:layout_alignParentEnd="true"
                android:id="@+id/img_sign1"
                android:layout_gravity="center_horizontal"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/shape_outline"
            android:elevation="2dp">
            <TextView
                android:id="@+id/tv2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textSize="14sp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="Signature of Attendent"/>
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="4dp"
                android:id="@+id/click2"
                android:src="@drawable/icon_pen"
                android:layout_below="@id/tv2"
                android:layout_alignParentEnd="true"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="80dp"
                android:layout_below="@id/tv2"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/click2"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="38sp"
                android:id="@+id/img_sign2"
                android:layout_gravity="center_horizontal"/>
        </RelativeLayout>

    </LinearLayout>
    <Button
        android:id="@+id/btn_submit"
        android:layout_alignParentBottom="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:gravity="center"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textAppearance="@android:style/TextAppearance.Large"
        android:text="SUBMIT"
        android:background="@drawable/button_dark_blue_bg"/>
</RelativeLayout>