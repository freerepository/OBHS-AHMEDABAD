<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.sedulous.obhsadi.activity.CleaningPicActivity">
    <RelativeLayout
        android:id="@+id/rl"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:elevation="8dp"
        android:background="@android:color/white"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="4dp"
            android:layout_centerVertical="true"
            android:src="@drawable/logo"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:layout_centerHorizontal="true"
            android:textColor="@color/colorPrimary"
            android:text="Dashboard"
            android:textSize="20dp"/>
    </RelativeLayout>
    <EditText
        android:id="@+id/et_trainno"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:inputType="number"
        android:maxLength="5"
        app:layout_constraintTop_toBottomOf="@+id/rl"
        app:layout_constraintBottom_toTopOf="@id/ll1"
        android:drawableStart="@drawable/train"
        android:drawablePadding="4dp"
        android:hint="Train No."/>
    <RelativeLayout
        android:id="@+id/ll1"
        android:background="@drawable/et_white_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        app:layout_constraintTop_toBottomOf="@+id/et_trainno"
        app:layout_constraintBottom_toTopOf="@+id/btn_submit">
        <TextView
            android:id="@+id/tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_alignParentTop="true"
            android:padding="4dp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:text=""/>
        <ImageView
            android:id="@+id/iv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:layout_below="@+id/tv"
            />
        <Button
            android:id="@+id/bt_cam"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerInside"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:background="@android:drawable/ic_menu_camera"
            android:src="@android:drawable/ic_menu_camera"/>
    </RelativeLayout>

    <Button
        android:id="@+id/btn_submit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@drawable/et_white_bg"
        android:backgroundTint="@color/colorPrimary"
        android:textColor="@android:color/white"
        android:textAllCaps="false"
        android:textSize="20dp"
        android:text="Submit"
        android:elevation="4dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
