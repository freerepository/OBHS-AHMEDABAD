<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#eeeeee"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="2dp"
            android:background="@drawable/et_white_bg"
            android:layout_margin="8dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:textColor="@color/hint_color"
                android:textStyle="bold"
                android:text="Select Date"/>
            <RelativeLayout
                android:id="@+id/rlv2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <EditText
                    android:id="@+id/et_journey_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:textColor="@android:color/black"/>
                <ImageView
                    android:id="@+id/ic_calender"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    app:tint="@color/black"
                    android:src="@drawable/down_arrow"
                    android:padding="4dp"/>

            </RelativeLayout>


        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="2dp"
            android:background="@drawable/et_white_bg"
            android:layout_margin="@dimen/_8sdp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:textColor="@color/hint_color"
                android:textStyle="bold"
                android:text="Station"/>
            <EditText
                android:id="@+id/et_station"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:textColor="@android:color/black"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/line1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/et_white_bg"
            android:padding="2dp"
            android:layout_margin="@dimen/_8sdp"
            android:layout_below="@id/rl">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:textColor="@color/hint_color"
                android:textStyle="bold"
                android:text="ID Card No."/>
            <EditText
                android:id="@+id/et_id_card_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/black"
                android:inputType="textCapCharacters"
                android:fontFamily="sans-serif"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/line2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/line1"
            android:layout_margin="@dimen/_8sdp"
            android:padding="2dp"
            android:background="@drawable/et_white_bg"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:textColor="@color/hint_color"
                android:textStyle="bold"
                android:text="Name of ACCA"/>
            <EditText
                android:id="@+id/et_name_accn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/black"
                android:autofillHints="username"
                android:fontFamily="sans-serif"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/line4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_8sdp"
            android:background="@drawable/et_white_bg"
            android:padding="2dp"
            android:layout_below="@id/line2"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:textColor="@color/hint_color"
                android:textStyle="bold"
                android:text="Select Train"/>

            <Spinner
                android:id="@+id/sp_train"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_32sdp"
                android:gravity="center_vertical"
                android:textColor="@android:color/black" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/line5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_8sdp"
            android:padding="2dp"
            android:background="@drawable/et_white_bg"
            android:layout_below="@id/line4"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:textColor="@color/hint_color"
                android:textStyle="bold"
                android:text="Select Coach"/>
            <Spinner
                android:id="@+id/sp_coach"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_32sdp"
                android:gravity="center_vertical"
                android:textColor="@android:color/black"/>

        </LinearLayout>
        <LinearLayout
            android:id="@+id/line6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_8sdp"
            android:padding="2dp"
            android:background="@drawable/et_white_bg"
            android:layout_below="@id/line4"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:textColor="@color/hint_color"
                android:textStyle="bold"
                android:text="Load"/>
            <EditText
                android:id="@+id/et_load"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/black"
                android:inputType="number"
                android:fontFamily="sans-serif"/>

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_8sdp"
            android:padding="2dp"
            android:background="@drawable/et_white_bg"
            android:layout_below="@id/line4"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:textColor="@color/hint_color"
                android:textStyle="bold"
                android:text="Select Class"/>
            <Spinner
                android:id="@+id/sp_class"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_32sdp"
                android:gravity="center_vertical"
                android:textColor="@android:color/black"/>
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
           android:text="Linen Item"
            android:background="@drawable/et_white_bg"
            android:layout_margin="@dimen/_8sdp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="@dimen/_8sdp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/line1"
            android:layout_margin="@dimen/_8sdp"
            android:padding="2dp"
            android:background="@drawable/et_white_bg"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:textColor="@color/hint_color"
                android:textStyle="bold"
                android:text="Bed sheet"/>
            <EditText
                android:id="@+id/et_bed_sheet_AC"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/black"
                android:inputType="text"
                android:fontFamily="sans-serif"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/line1"
            android:layout_margin="@dimen/_8sdp"
            android:padding="2dp"
            android:background="@drawable/et_white_bg"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:textColor="@color/hint_color"
                android:textStyle="bold"
                android:text="Pillow"/>
            <EditText
                android:id="@+id/et_pillow_AC"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/black"
                android:inputType="text"
                android:fontFamily="sans-serif"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/line1"
            android:layout_margin="@dimen/_8sdp"
            android:padding="2dp"
            android:background="@drawable/et_white_bg"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:textColor="@color/hint_color"
                android:textStyle="bold"
                android:text="Pillow Cover"/>
            <EditText
                android:id="@+id/et_pillow_cover"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/black"
                android:inputType="text"
                android:fontFamily="sans-serif"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/line1"
            android:layout_margin="@dimen/_8sdp"
            android:padding="2dp"
            android:background="@drawable/et_white_bg"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:textColor="@color/hint_color"
                android:textStyle="bold"
                android:text="Bath Towel"/>
            <EditText
                android:id="@+id/et_bath_towel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/black"
                android:inputType="text"
                android:fontFamily="sans-serif"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/line1"
            android:layout_margin="@dimen/_8sdp"
            android:padding="2dp"
            android:background="@drawable/et_white_bg"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:textColor="@color/hint_color"
                android:textStyle="bold"
                android:text="Face Towel"/>
            <EditText
                android:id="@+id/et_face_towel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/black"
                android:inputType="text"
                android:fontFamily="sans-serif"
                />

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/line1"
            android:layout_margin="@dimen/_8sdp"
            android:padding="2dp"
            android:background="@drawable/et_white_bg"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:textColor="@color/hint_color"
                android:textStyle="bold"
                android:text="Blanket"/>
            <EditText
                android:id="@+id/et_blanket"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/black"
                android:inputType="text"
                android:fontFamily="sans-serif" />

        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Linen item Image"
            android:background="@drawable/et_white_bg"
            android:layout_margin="@dimen/_8sdp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="@dimen/_8sdp"/>
        <LinearLayout
            android:id="@+id/camera_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/layout"
            android:background="@drawable/et_white_bg"
            android:orientation="horizontal"
            android:layout_margin="@dimen/_8sdp"
            android:padding="8dp">
            <LinearLayout
                android:id="@+id/ll1"
                android:orientation="vertical"
                android:layout_width="@dimen/_140sdp"
                android:layout_height="@dimen/_140sdp"
                android:layout_weight="1"
                android:background="@drawable/et_white_bg"
                android:elevation="2dp"
                android:layout_margin="8dp">
                <ImageView
                    android:id="@+id/iv_train1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:src="@android:drawable/ic_menu_camera"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/ll2"
                android:orientation="vertical"
                android:layout_width="@dimen/_140sdp"
                android:layout_height="@dimen/_140sdp"
                android:layout_weight="1"
                android:background="@drawable/et_white_bg"
                android:elevation="2dp"
                android:layout_margin="8dp">
                <ImageView
                    android:id="@+id/iv_train2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:src="@android:drawable/ic_menu_camera"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/signature_layout"
            android:layout_below="@id/camera_layout"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_margin="@dimen/_8sdp"
            android:background="@drawable/et_white_bg"
            android:orientation="horizontal">

            <RelativeLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_outline"
                android:layout_marginEnd="5dp"
                android:elevation="2dp">
                <TextView
                    android:id="@+id/tv1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textAppearance="@android:style/TextAppearance.Medium"
                    android:text="Sig. of supervisor"/>
                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginEnd="4dp"
                    android:layout_below="@id/tv1"
                    android:layout_alignParentEnd="true"
                    android:id="@+id/click1"
                    android:layout_gravity="center_horizontal"
                    android:src="@drawable/icon_pen"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="80dp"
                    android:layout_below="@id/tv1"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@+id/click1"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="38sp"
                    android:id="@+id/img_sign1"
                    android:layout_gravity="center_horizontal"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:background="@drawable/shape_outline"
                android:elevation="2dp">
                <TextView
                    android:id="@+id/tv2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textSize="12sp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textAppearance="@android:style/TextAppearance.Medium"
                    android:text="Sig. of Attendent"/>
                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginEnd="4dp"
                    android:id="@+id/click2"
                    android:src="@drawable/icon_pen"
                    android:layout_below="@id/tv2"
                    android:layout_alignParentEnd="true"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="80dp"
                    android:layout_below="@id/tv2"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@+id/click2"
                    android:layout_marginEnd="38sp"
                    android:layout_alignParentEnd="true"
                    android:id="@+id/img_sign2"
                    android:layout_gravity="center_horizontal"/>
            </RelativeLayout>

        </LinearLayout>
        <Button
            android:id="@+id/btn_submit"
            android:layout_alignParentBottom="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textAppearance="@android:style/TextAppearance.Large"
            android:text="SUBMIT"
            android:background="@drawable/button_dark_blue_bg"/>
    </LinearLayout>

</ScrollView>