<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.sedulous.obhsadi">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- amardeep -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/AppTheme.NoActionBar">
        <activity
            android:name="com.sedulous.obhsadi.activitylinen.UserListActivity"
            android:exported="false" />
        <activity
            android:name="com.sedulous.obhsadi.activitylinen.PreCleaning"
            android:exported="false" />
        <activity
            android:name="com.sedulous.obhsadi.activitylinen.TakeCaSingatureActivity"
            android:exported="false" />
        <activity
            android:name="com.sedulous.obhsadi.activitylinen.AttendanceListActivity"
            android:exported="false" />
        <activity
            android:name="com.sedulous.obhsadi.activitylinen.EmpInListActvity"
            android:exported="false" />
        <activity
            android:name="com.sedulous.obhsadi.activitylinen.AttendanceOutActivity"
            android:exported="false" />
        <activity
            android:name="com.sedulous.obhsadi.activitylinen.AttendanceInActivity"
            android:exported="false" />
        <activity
            android:name="com.sedulous.obhsadi.activitylinen.AttendanceAllotment"
            android:exported="false" />
        <activity
            android:name="com.sedulous.obhsadi.activitylinen.ReceviceLostLinenActivity"
            android:exported="false" />
        <activity
            android:name="com.sedulous.obhsadi.activitylinen.PenaltyLinenActivity"
            android:exported="false" />
        <activity
            android:name="com.sedulous.obhsadi.activitylinen.RegistraionActivity"
            android:exported="false" />
        <activity
            android:name="com.sedulous.obhsadi.activitylinen.SupervisorActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.sedulous.obhsadi.activity.CleaningPicActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.sedulous.obhsadi.activity.GroupPicActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.sedulous.obhsadi.activity.HomeActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.sedulous.obhsadi.activity.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.sedulous.obhsadi.activity.LoginUserSelectionActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.sedulous.obhsadi.activity.LoginActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden" />
        <activity
            android:name="com.sedulous.obhsadi.activity.AcNonAcSelectionActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.sedulous.obhsadi.activity.PassengerDetailsActivity"
            android:label="@string/title_activity_passenger_details"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="stateHidden" />
        <activity
            android:name="com.sedulous.obhsadi.activity.PassengerFeedbackAcActivity"
            android:label="@string/title_activity_passenger_feedback"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name="com.sedulous.obhsadi.activity.PassengerFeedbackNonAcActivity"
            android:label="@string/title_activity_passenger_feedback_non_ac"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name="com.sedulous.obhsadi.activity.InspectorReviewActivity"
            android:label="@string/title_activity_inspector_review"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="stateHidden" />
        <activity
            android:name="com.sedulous.obhsadi.activity.OtpVerifyActivity"
            android:label="@string/title_activity_otp_verify"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="stateHidden" />
        <activity
            android:name="com.sedulous.obhsadi.activity.TteDetailActivity"
            android:label="@string/title_activity_tte_detail"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name="com.sedulous.obhsadi.activity.TteFeedbackActivity"
            android:label="@string/title_activity_tte_feedback"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name="com.sedulous.obhsadi.activity.CaptureSignatureActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/fileprovider" />
        </provider>
    </application>

</manifest>